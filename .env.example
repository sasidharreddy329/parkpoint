VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Use `hash` for GitHub Pages or other static hosts without SPA rewrites.
# Use `browser` for Render, Netlify, Vercel, and most app/static hosts with rewrites.
VITE_ROUTER_MODE=browser

# Use `/repo-name/` for GitHub Pages project sites. Keep `/` for most other hosts.
VITE_BASE_PATH=/
